# =====================================================================
# Environment variables
#
# Audited against every process.env / Deno.env reference in src/,
# middleware.ts, supabase/functions/ and scripts/. Anything below marked
# NOT YET READ is documented for completeness but no code reads it today —
# it is listed so you know it is optional, not so you go hunting for a key
# the app will silently ignore.
#
# Copy to .env.local for development. Set the REQUIRED block in Vercel
# (Production + Preview) before the first deploy.
# =====================================================================

# ---------------------------------------------------------------------
# REQUIRED — Platform
# ---------------------------------------------------------------------

# The apex domain the three surfaces hang off. Middleware splits every
# request host against this, so getting it wrong routes every storefront
# to the marketing page.
#   local:      localhost           (admin.localhost:3000 etc. just work)
#   production: platform.com
# DNS needs an A/CNAME for the apex, `admin`, `app`, AND a wildcard
# `*.<root>` for tenant subdomains.
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# ---------------------------------------------------------------------
# REQUIRED — Supabase
# ---------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — it is what reads tenant_secrets and
# writes orders from the Stripe webhook. Never prefix with NEXT_PUBLIC_,
# never expose to a browser, and rotate it if it ever lands in a log.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# REQUIRED — Stripe (platform account)
#
# Per-tenant connected accounts live in payment_gateway_accounts; these are
# the PLATFORM's credentials, which collect the technology fee.
# ---------------------------------------------------------------------

STRIPE_SECRET_KEY=sk_live_...

# From the Stripe dashboard webhook endpoint pointing at
# https://<root-domain>/api/webhooks/stripe
# Subscribe to: checkout.session.completed,
#               checkout.session.async_payment_succeeded,
#               payment_intent.succeeded
# Without this the webhook route returns 500 and no order is ever created.
STRIPE_WEBHOOK_SECRET=whsec_...

# NOT YET READ. Checkout is Stripe-hosted (the customer is redirected), so
# no Stripe.js runs in the browser. Needed only if you move to embedded
# Checkout or Elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ---------------------------------------------------------------------
# REQUIRED — Security secrets
#
# Generate each with:  openssl rand -base64 32
# ---------------------------------------------------------------------

# Signs the super-admin impersonation cookie. If unset the code falls back
# to SUPABASE_SERVICE_ROLE_KEY, which works but means rotating that key
# also invalidates every open impersonation session. Set it explicitly.
IMPERSONATION_SECRET=

# Bearer token the scheduler presents to POST /api/admin/webhooks/drain.
# If unset, the endpoint is reachable only by a signed-in super admin —
# which means the cron job silently stops draining the outbound webhook
# outbox, and CRM notifications quietly stop retrying.
CRON_SECRET=

# ---------------------------------------------------------------------
# Courier dispatch
#
# The provider's BASE URL only. Per-tenant API keys are NOT env vars —
# they live in the tenant_secrets table under `shipday_api_key`, readable
# by the service role alone, because every restaurant has its own account.
#
# Set this in BOTH places: Vercel (the tracking proxy reads it) and the
# Edge Function (supabase secrets set DISPATCH_API_BASE_URL=...).
# ---------------------------------------------------------------------

DISPATCH_API_BASE_URL=https://api.shipday.com

# NOT YET READ. Reserved for verifying inbound courier status webhooks;
# no such route exists yet — tracking currently polls the provider.
DISPATCH_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# NOT YET READ — additional payment gateways
#
# The payment_provider enum and payment_gateway_accounts table support
# these, but only the Stripe adapter is implemented. Leave unset.
# ---------------------------------------------------------------------

SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------
# NOT YET READ — automated custom-domain provisioning
#
# tenant_domains is verified manually today. These are for adding tenant
# hostnames to the Vercel project programmatically.
# ---------------------------------------------------------------------

VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_API_TOKEN=

# ---------------------------------------------------------------------
# Local development only — never set in Vercel
# ---------------------------------------------------------------------

# Password given to the seeded demo accounts by scripts/seed-demo.ts.
DEMO_PASSWORD=DemoPass!2026

# =====================================================================
# Set on the Supabase project, NOT in Vercel
# =====================================================================
#
#   supabase secrets set DISPATCH_API_BASE_URL=https://api.shipday.com
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge
# Functions automatically — do not set them by hand.
